<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pioneer3dx" >

  <!-- Import Rviz colors -->
  <xacro:include filename="$(find sim_env)/urdf/pioneer3dx/materials.xacro" />
  
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- Import robot -->
  <xacro:include filename="$(find sim_env)/urdf/pioneer3dx/pioneer3dx_body.xacro"/>
  <xacro:pioneer3dx_body name="chassis" parent="base_link" meshes="package://sim_env/urdf/pioneer3dx/meshes/p3dx"/>

  <!-- Laser -->
  <xacro:include filename="$(find sim_env)/urdf/pioneer3dx/laser/hokuyo.xacro"/>
  <xacro:laser name="front_laser" parent="chassis" xyz="0 0 0.25" rpy="0 0 0" meshes="package://sim_env/urdf/pioneer3dx/meshes/laser"/>


  <!-- GPU Laser
  <xacro:include filename="$(find sim_env)/urdf/pioneer3dx/laser/hokuyo_gpu.xacro"/>
  <xacro:laser_gpu name="front_laser" parent="chassis" xyz="0.16 0 0.1" rpy="0 0 0" meshes="package://sim_env/urdf/pioneer3dx/meshes/laser" />
    -->
  <xacro:include filename="$(find sim_env)/urdf/pioneer3dx/camera/camera.xacro"/>
  <xacro:cam name="front_camera" parent="chassis" xyz="0.025 0 0.32" rpy="0 0 0" />


</robot>
