<?xml version="1.0"?>
<robot name="forklift" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find sim_env)/urdf/forklift/forklift_base.xacro" />

  <!-- Camera property definitions (keep from original model) -->
  <xacro:property name="r200_cam_rgb_px" value="0.0017" />
  <xacro:property name="r200_cam_rgb_py" value="0.006" />
  <xacro:property name="r200_cam_rgb_pz" value="0.0043" />
  <xacro:property name="r200_cam_depth_offset" value="0.0033" />

  <!-- Base footprint as root - 必须有惯性参数才能让 Gazebo 正确计算速度 -->
  <link name="base_footprint">
    <inertial>
      <mass value="0.0000037"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0000037" ixy="0" ixz="0"
              iyy="0.0000037" iyz="0"
              izz="0.0000037"/>
    </inertial>
  </link>

  <!-- Instantiate forklift base: front_axle + 4 wheels -->
  <xacro:forklift_base parent_link="base_footprint" />

  <!-- IMU link on main chassis (front_axle) -->
  <joint name="imu_joint" type="fixed">
    <parent link="front_axle" />
    <child link="imu_link" />
    <origin xyz="0.0 0 0.0227" rpy="0 0 0" />
  </joint>
  <link name="imu_link">
    <inertial>
      <mass value="0.000037"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0000037" ixy="0" ixz="0"
              iyy="0.0000037" iyz="0"
              izz="0.0000037"/>
    </inertial>
  </link>

  <!-- 2D lidar on chassis -->
  <joint name="scan_joint" type="fixed">
    <parent link="front_axle" />
    <child link="base_scan" />
    <origin xyz="-0.1167 0 0.0833" rpy="0 0 0" />
  </joint>

  <link name="base_scan">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sim_env/meshes/turtlebot3/sensors/lds.stl" scale="0.000333 0.000333 0.000333" />
      </geometry>
      <material name="dark" />
    </visual>

    <collision>
      <origin xyz="0.005 0 -0.0022" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.0105" radius="0.0183" />
      </geometry>
    </collision>

    <inertial>
      <mass value="0.0042" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.000037" ixy="0.0" ixz="0.0"
               iyy="0.000037" iyz="0.0"
               izz="0.000037" />
    </inertial>
  </link>

  <!-- Additional collision element for laser detection -->
  <joint name="laser_detection_joint" type="fixed">
    <parent link="front_axle" />
    <child link="laser_detection_element" />
    <origin xyz="0 0 0.25" rpy="0 0 0" />
  </joint>

  <link name="laser_detection_element">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.3 0.2 0.1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.001" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0"
               iyy="0.000001" iyz="0.0"
               izz="0.000001" />
    </inertial>
  </link>

  <!-- Realsense camera on chassis -->
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.0213 -0.0217 0.1667" rpy="0 0 0" />
    <parent link="front_axle" />
    <child link="camera_link" />
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 1.57" />
      <geometry>
        <mesh filename="package://sim_env/meshes/turtlebot3/sensors/r200.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.001 0.0217 0.0023" rpy="0 0 0" />
      <geometry>
        <box size="0.004 0.044 0.0067" />
      </geometry>
    </collision>
  </link>

  <joint name="camera_rgb_joint" type="fixed">
    <origin xyz="${r200_cam_rgb_px} ${r200_cam_rgb_py} ${r200_cam_rgb_pz}" rpy="0 0 0" />
    <parent link="camera_link" />
    <child link="camera_rgb_frame" />
  </joint>
  <link name="camera_rgb_frame" />

  <joint name="camera_rgb_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57" />
    <parent link="camera_rgb_frame" />
    <child link="camera_rgb_optical_frame" />
  </joint>
  <link name="camera_rgb_optical_frame" />

  <joint name="camera_depth_joint" type="fixed">
    <origin xyz="${r200_cam_rgb_px} ${r200_cam_rgb_py + r200_cam_depth_offset} ${r200_cam_rgb_pz}" rpy="0 0 0" />
    <parent link="camera_link" />
    <child link="camera_depth_frame" />
  </joint>
  <link name="camera_depth_frame" />

  <joint name="camera_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57" />
    <parent link="camera_depth_frame" />
    <child link="camera_depth_optical_frame" />
  </joint>
  <link name="camera_depth_optical_frame" />

</robot>
