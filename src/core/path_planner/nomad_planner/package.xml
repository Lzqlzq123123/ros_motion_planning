<?xml version="1.0"?>
<package format="2">
  <name>nomad_planner</name>
  <version>0.0.1</version>
  <description>NoMaD global planner plugin that bridges NoMaD diffusion planner with move_base.</description>

  <maintainer email="maintainer@example.com">ros_motion_planning</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>nav_core</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>costmap_2d</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>nomad_planner_msgs</build_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>nav_core</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>costmap_2d</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nomad_planner_msgs</exec_depend>

  <export>
    <nav_core plugin="${prefix}/nomad_planner_plugin.xml" />
  </export>
</package>
